import { Palette } from "theme.slint";

// The overlay window is opaque: the Vulkan swapchain on this driver carries no
// per-pixel alpha, and a layered colour key is ignored by the compositor for
// this surface, so the card is the visible object and the window rectangle
// around it uses the same surface colour.
export component OsdWindow inherits Window {
    in property <string> osd-title: "";
    in property <string> osd-detail: "";
    in property <color> osd-accent: Palette.cyan;
    in-out property <float> osd-reveal: 0.0;

    width: 320px;
    height: 84px;
    background: Palette.surface;
    title: "RAM CONTROL CENTER OSD";
    no-frame: true;
    always-on-top: true;

    card := Rectangle {
        x: 8px;
        y: 8px + (1.0 - root.osd-reveal) * 10px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        border-radius: 13px;
        background: Palette.surface-gradient;
        border-width: 1px;
        border-color: root.osd-accent.with-alpha(0.55);
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000C0;
        transform-scale-x: 0.97 + 0.03 * root.osd-reveal;
        transform-scale-y: 0.97 + 0.03 * root.osd-reveal;
        animate y { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate transform-scale-x { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate transform-scale-y { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 12px;

            Rectangle {
                width: 4px;
                border-radius: 2px;
                background: root.osd-accent;
            }

            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: root.osd-title;
                    color: Palette.text;
                    font-family: "Bahnschrift";
                    font-size: 17px;
                    font-weight: 650;
                    overflow: elide;
                }
                Text {
                    text: root.osd-detail;
                    color: Palette.text-dim;
                    font-family: "Microsoft YaHei UI";
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}
