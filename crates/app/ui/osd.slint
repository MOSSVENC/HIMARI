import { Palette } from "theme.slint";

export component OsdWindow inherits Window {
    in property <string> osd-title: "";
    in property <string> osd-detail: "";
    in property <color> osd-accent: Palette.cyan;
    in-out property <float> osd-reveal: 0.0;

    width: 360px;
    height: 96px;
    background: Palette.surface;
    title: "RAM CONTROL CENTER OSD";
    no-frame: true;
    always-on-top: true;

    Rectangle {
        x: 6px;
        y: 6px + (1.0 - root.osd-reveal) * 12px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        border-radius: 18px;
        background: Palette.surface-gradient;
        border-width: 1px;
        border-color: root.osd-accent.with-alpha(0.72);
        opacity: root.osd-reveal;
        transform-scale-x: 0.96 + 0.04 * root.osd-reveal;
        transform-scale-y: 0.96 + 0.04 * root.osd-reveal;
        animate y { duration: 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate transform-scale-x { duration: 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate transform-scale-y { duration: 240ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 14px;

            Rectangle {
                width: 4px;
                border-radius: 2px;
                background: root.osd-accent;
            }

            VerticalLayout {
                alignment: center;
                spacing: 5px;
                Text {
                    text: root.osd-title;
                    color: Palette.text;
                    font-family: "Bahnschrift";
                    font-size: 18px;
                    font-weight: 650;
                    overflow: elide;
                }
                Text {
                    text: root.osd-detail;
                    color: Palette.text-dim;
                    font-family: "Microsoft YaHei UI";
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}
